{
  "name": "@mcet/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text-policy": {
      "types": "./dist/text-policy.d.ts",
      "default": "./dist/text-policy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "openapi": "node scripts/business-openapi.mjs",
    "openapi:check": "node scripts/business-openapi.mjs --check"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mcet/tsconfig": "workspace:*",
    "typescript": "7.0.2"
  }
}
