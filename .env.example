# Variables para desarrollo local. Copiar a .env (que nunca se sube).
# Los secretos propios llevan valores ficticios SOLO para desarrollo.
# Las claves de terceros quedan VACÍAS: la función se desactiva sola mientras falten.

# ── Sitio e idiomas ───────────────────────────────────────────────
IDIOMAS=es,en
SITE_URL=http://micitaentiempo.localhost:8080
SITE_URL_ES=http://micitaentiempo.localhost:8080
SITE_URL_EN=http://myappointmentontime.localhost:8080
# Solo desarrollo: host → idioma (en producción se deriva de SITE_URL_ES / SITE_URL_EN)
HOST_LANG_MAP=micitaentiempo.localhost:es,myappointmentontime.localhost:en,localhost:es,127.0.0.1:en
TRUSTED_PROXY_CIDR=0.0.0.0/0

# ── Imágenes (producción) ─────────────────────────────────────────
IMAGE_PREFIX=local/micitaentiempo
IMAGE_TAG=dev

# ── Correo (en local, Mailpit) ────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASSWORD=dev
MAIL_FROM="Mi Cita en Tiempo <no-reply@micitaentiempo.localhost>"
SMTP_USER_EN=dev
SMTP_PASSWORD_EN=dev
MAIL_FROM_EN="My Appointment On Time <no-reply@myappointmentontime.localhost>"

# ── Newsletter y analítica (opcionales) ───────────────────────────
LISTMONK_URL=
LISTMONK_LIST_UUID=
LISTMONK_URL_EN=
LISTMONK_LIST_UUID_EN=
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# ── Secretos propios (en producción los genera la plataforma) ─────
POSTGRES_PASSWORD=dev-postgres
API_DB_PASSWORD=dev-api
CALENDAR_DB_PASSWORD=dev-calendar
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0000000000
APP_ENC_KEY=dev-app-enc-key-change-me-00000000000000000
ALTCHA_HMAC_KEY=dev-altcha-hmac-key-change-me-000000000000
RPC_SECRET_API_TO_CALENDAR=dev-rpc-api-to-calendar-000000000000000000
RPC_SECRET_CALENDAR_TO_API=dev-rpc-calendar-to-api-000000000000000000
CALENDAR_TOKEN_ENC_KEY=dev-calendar-token-enc-key-0000000000000000
GOOGLE_CHANNEL_SECRET=dev-google-channel-secret-000000000000000
MS_CLIENT_STATE_SECRET=dev-ms-client-state-secret-00000000000000
TELEGRAM_WEBHOOK_SECRET=dev-telegram-webhook-secret-000000000000

# ── Terceros: vacías = desactivado ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Stripe: sin configurar por decisión del 2026-10-06
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TAX_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# WhatsApp: sin configurar por decisión del 2026-10-06
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
