{
  "extends": "@mcet/tsconfig/library.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2024", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".features-gen"]
}
