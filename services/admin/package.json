{
  "name": "@mcet/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & pnpm -C ui watch & node --watch dist/index.js)",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@mcet/tsconfig": "workspace:*",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@mcet/admin-ui": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
